#!/usr/bin/env bash

set -Eeuo pipefail

#######################################
# Bootstrap
#######################################

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=../lib/common.sh
source "$SCRIPT_DIR/../lib/common.sh"

#######################################
# Configuration
#######################################

COMMIT_MSG=""
FORCE_FLAG=false

#######################################
# Helpers
#######################################

usage() {
    cat <<EOF
Usage:
  git-utils -m <message> [-f] [--verbose]

Options:
  -m <message>      Commit message (required)
  -f                Force push (prompts for confirmation)
  --verbose         Enable bash debug output
  -h, --help        Show this help message
EOF
}

get_current_branch() {
    git symbolic-ref --quiet --short HEAD || {
        die "Could not determine the current branch"
    }
}

validate_branch() {
    local branch
    branch="$(get_current_branch)"

    log "Current branch is '$branch'"

    if [[ "$branch" == "main" || "$branch" == "master" ]]; then
        warn "You are pushing directly to '$branch'"
    fi
}

has_pending_changes() {
    [[ -n "$(git status --porcelain)" ]]
}

confirm_force_push() {
    local confirmation

    echo -n "Force push? This may overwrite remote history. Continue? (y/N): "
    read -r confirmation

    if [[ ! "$confirmation" =~ ^[Yy]$ ]]; then
        warn "Force push aborted"
        exit 0
    fi
}

#######################################
# Argument parsing
#######################################

while [[ $# -gt 0 ]]; do
    case "$1" in
        -m)
            [[ $# -ge 2 ]] || die "Option -m requires a commit message"
            COMMIT_MSG="$2"
            shift 2
            ;;
        -f)
            FORCE_FLAG=true
            shift
            ;;
        --verbose)
            set -x
            shift
            ;;
        -h | --help)
            usage
            exit 0
            ;;
        *)
            error "Unknown argument: $1"
            usage
            exit 1
            ;;
    esac
done

if [[ -z "$COMMIT_MSG" ]]; then
    error "Commit message (-m) is required"
    usage
    exit 1
fi

#######################################
# Main
#######################################

main() {
    require_command git

    cd_to_git_root
    validate_branch

    if ! has_pending_changes; then
        log "No changes to commit. Exiting."
        exit 0
    fi

    run_step "Staging changes" \
        git add -A

    run_step "Creating commit" \
        git commit -m "$COMMIT_MSG"

    if [[ "$FORCE_FLAG" == true ]]; then
        confirm_force_push
        run_step "Force pushing changes" \
            git push -f
    else
        run_step "Pushing changes" \
            git push
    fi

    success "Changes committed and pushed successfully"
}

main
