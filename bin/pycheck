#!/usr/bin/env bash

set -Eeuo pipefail

#######################################
# Bootstrap
#######################################

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=../lib/common.sh
source "$SCRIPT_DIR/../lib/common.sh"

#######################################
# Helpers
#######################################

usage() {
    cat <<EOF
Usage:
  pycheck [options]

Runs formatting, linting, type checking, pre-commit, and tests.

Options:
  --lint-only       Run checks but skip pytest
  --test-only       Run pytest only; skip format, lint, typecheck, and pre-commit
  --verbose         Enable bash debug output
  -h, --help        Show this help message

Examples:
  pycheck
  pycheck --lint-only
  pycheck --test-only
EOF
}

find_precommit_config() {
    local candidate
    for candidate in .pre-commit-config.yaml .pre-commit-config.yml; do
        if [[ -f "$candidate" ]]; then
            echo "$candidate"
            return 0
        fi
    done
    return 1
}

#######################################
# Argument parsing
#######################################

while [[ $# -gt 0 ]]; do
    case "$1" in
        --lint-only)
            set_check_mode lint
            shift
            ;;
        --test-only)
            set_check_mode test
            shift
            ;;
        --verbose)
            set -x
            shift
            ;;
        -h | --help)
            usage
            exit 0
            ;;
        *)
            error "Unknown argument: $1"
            usage
            exit 1
            ;;
    esac
done

#######################################
# Main
#######################################

main() {
    require_command uv
    require_command git

    cd_to_git_root

    if [[ -f ".venv/bin/activate" ]]; then
        log "Detected virtual environment (.venv)"
    else
        warn "No .venv found (uv will still manage environments)"
    fi

    if [[ "$CHECK_MODE" != "test" ]]; then
        run_step "Running Ruff auto-fixes" \
            uv run ruff check --fix

        run_step "Running Ruff formatter" \
            uv run ruff format

        run_step "Running Pyright" \
            uv run pyright

        local precommit_config
        if precommit_config="$(find_precommit_config)"; then
            run_step "Running pre-commit hooks" \
                uv run pre-commit run --all-files --config "$precommit_config"
        else
            warn "Skipping pre-commit (no .pre-commit-config.yaml found)"
        fi
    fi

    if [[ "$CHECK_MODE" == "lint" ]]; then
        success "$(check_mode_complete_message)"
        exit 0
    fi

    run_step "Running pytest" \
        uv run pytest

    success "$(check_mode_complete_message)"
}

main
